# Supabase project (Project Settings → API). Both are safe to expose to the browser:
# row level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of the site, without a trailing slash. Required in production: used for
# canonical URLs, Open Graph, the sitemap, and links in auth emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Not used yet. Needed later on the server only (payment webhooks). Never prefix it with
# NEXT_PUBLIC_ — it bypasses row level security.
# SUPABASE_SERVICE_ROLE_KEY=
