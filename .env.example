# Supabase project (Project Settings → API). Both are safe to expose to the browser:
# row level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of the site, without a trailing slash. Required in production: used for
# canonical URLs, Open Graph, the sitemap, links in auth emails, and the "View Your Order"
# button in the order confirmation email.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Order confirmation emails, sent through Resend (https://resend.com).
# Server-side only — never add NEXT_PUBLIC_ to the API key. Leave these unset and orders
# still work; the admin panel then shows that email sending isn't configured.
# RESEND_API_KEY: Resend dashboard → API Keys → Create API Key (sending access is enough).
RESEND_API_KEY=re_your_api_key
# The sender. Its domain must be verified in Resend before it can be used.
ORDER_EMAIL_FROM=Store Name <orders@your-domain.com>
# Optional. Where customer replies go, if that isn't the sender address.
# ORDER_EMAIL_REPLY_TO=support@your-domain.com
# Optional. Overrides the Resend endpoint; only the automated tests set this.
# RESEND_API_URL=https://api.resend.com/emails

# Not used yet. Needed later on the server only (payment webhooks). Never prefix it with
# NEXT_PUBLIC_ — it bypasses row level security.
# SUPABASE_SERVICE_ROLE_KEY=
